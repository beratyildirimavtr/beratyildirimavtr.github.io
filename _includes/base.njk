<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{% if baslik %}{{ baslik }} | {% endif %}{{ site.ad }}</title>
<meta name="description" content="{{ aciklama or ozet or site.aciklama }}">
{% if not site.yayinda %}<meta name="robots" content="noindex, nofollow">{% endif %}
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:type" content="website">
<meta property="og:title" content="{{ baslik or site.ad }}">
<meta property="og:description" content="{{ aciklama or ozet or site.aciklama }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:locale" content="tr_TR">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E⚖️%3C/text%3E%3C/svg%3E">
<link rel="stylesheet" href="/css/stil.css">
</head>
<body>
{% set akt = aktifMenu or page.url %}
<header class="top">
  <a class="brand" href="/">{{ site.ad }}</a>
  <p class="tagline">{{ site.altBaslik }}</p>
</header>
<div class="navwrap"><nav class="cap" aria-label="Ana menü">
{%- for m in menu %}<a href="{{ m.url }}"{% if m.url == akt %} aria-current="page"{% endif %}>{{ m.ad }}</a>{% endfor -%}
</nav></div>
<main>
{{ content | safe }}
</main>
<footer class="site"><div class="wrap">
  <div class="row"><span>© {{ site.yil }} {{ iletisim.unvan }}</span><a href="/gizlilik/">Gizlilik Politikası</a><a href="/kvkk/">KVKK Aydınlatma Metni</a></div>
  <p>Bu sitedeki içerikler genel bilgilendirme amaçlıdır; somut bir olay için hukuki danışmanlık yerine geçmez.</p>
</div></footer>
</body>
</html>
