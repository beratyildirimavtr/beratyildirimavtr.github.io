{% set b = d | kararBilgi(collections.konular, collections.gruplar) %}
<article class="dcard g" style="{{ b.gr | gstil }}" data-grup="{{ b.kn.data.grup if b.kn else '' }}">
  <div class="top">
    {% if b.kn %}<a class="gpill" href="{{ b.kn.url }}">{{ b.kn.data.baslik }}</a>{% endif %}
    {% if d.data.ornek %}<span class="sample">Örnek içerik</span>{% endif %}
  </div>
  <h3><a href="{{ d.url }}">{{ d.data.baslik }}</a></h3>
  <p>{{ d.data.ozet }}</p>
  <div class="meta"><span>{{ d.data.mahkeme or "Yargıtay" }} {{ d.data.daire }}</span><span>E. {{ d.data.esas }} · K. {{ d.data.karar }}</span>{% if d.data.madde %}<span>{{ d.data.madde }}</span>{% endif %}</div>
</article>
