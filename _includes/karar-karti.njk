<article class="decision">
  <div class="rail">
    <b>Yargıtay {{ d.data.daire }}</b>
    <div>Esas: <strong>{{ d.data.esas }}</strong></div>
    <div>Karar: <strong>{{ d.data.karar }}</strong></div>
    <div>Tarih: <strong>{{ d.data.tarih }}</strong></div>
  </div>
  <div class="body">
    {% if d.data.ornek %}<span class="sample">Örnek içerik</span>{% endif %}
    <h3><a href="{{ d.url }}">{{ d.data.baslik }}</a></h3>
    <p>{{ d.data.ozet }}</p>
    <p class="src">{% if d.data.madde %}İlgili madde: {{ d.data.madde }} · {% endif %}Yayın: {{ d.date | tarihTR }}</p>
  </div>
</article>
