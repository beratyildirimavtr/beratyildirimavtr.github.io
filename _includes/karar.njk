---
layout: base.njk
---
{% set b = page | kararBilgiSayfa(collections.konular, collections.gruplar, konu) %}
<div class="wrap pad">
  <p class="crumb"><a href="/yargitay-kararlari/">Yargıtay Kararları</a>{% if b.kn %} / <a href="{{ b.kn.url }}">{{ b.kn.data.baslik }}</a>{% endif %}</p>
  <div class="pagehead g" style="{{ b.gr | gstil }}">
    {% if ornek %}<span class="sample">Örnek içerik</span>{% endif %}
    <h1>{{ baslik }}</h1>
  </div>
  <div class="kunye"><span>{{ mahkeme or "Yargıtay" }} {{ daire }}</span><span>Esas {{ esas }}</span><span>Karar {{ karar }}</span><span>{{ tarih }}</span>{% if madde %}<span>{{ madde }}</span>{% endif %}</div>
  {% if ozet %}<div class="sumbox"><b>Özet</b>{{ ozet }}</div>{% endif %}
  {% if content | trim %}<div class="fulltext"><h3>Karar metni</h3>{{ content | safe }}{% if kaynak %}<p class="srcline">Kaynak: <a href="{{ kaynak }}" rel="noopener">{{ kaynak }}</a></p>{% endif %}</div>{% endif %}
</div>
