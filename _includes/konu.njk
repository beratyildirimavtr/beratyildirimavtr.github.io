---
layout: base.njk
---
{% set gr = collections.gruplar | grupBul(grup) %}
{% set kararlarim = collections.kararSirali | konuKararlari(page.fileSlug) %}
<div class="wrap pad">
  <div class="hubhead g" style="{{ gr | gstil }}">
    <p class="crumb"><a href="/">Ana Sayfa</a> / {% if gr %}<a href="{{ gr.url }}">{{ gr.data.baslik }}</a>{% endif %}</p>
    <h1>{{ baslik }}</h1>
    {% if aciklama %}<p>{{ aciklama }}</p>{% endif %}
  </div>
  {% if content | trim %}<div class="textcard">{{ content | safe }}</div>{% endif %}
  <h2 class="sec">Kararlar{% if kararlarim.length %} <small>({{ kararlarim.length }})</small>{% endif %}</h2>
  {% if kararlarim.length %}
  <div class="dlist">{% for d in kararlarim %}{% include "karar-karti.njk" %}{% endfor %}</div>
  {% else %}
  <p class="empty">Bu konuya henüz karar eklenmedi.</p>
  {% endif %}
</div>
