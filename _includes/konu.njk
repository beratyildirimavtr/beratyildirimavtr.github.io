---
layout: base.njk
---
{% set gr = collections.gruplar | grupBul(grup) %}
{% set digerleri = collections.konularSirali | digerKonular(grup, page.url) %}
<div class="wrap pad">
  <div class="hubhead g" style="{{ gr | gstil }}">
    <p class="crumb"><a href="/">Ana Sayfa</a> / {% if gr %}<a href="{{ gr.url }}">{{ gr.data.baslik }}</a>{% endif %}</p>
    <h1>{{ baslik }}</h1>
    {% if aciklama %}<p>{{ aciklama }}</p>{% endif %}
    <p class="meta"><time datetime="{{ page.date | isoTarih }}">{{ page.date | tarihTR }}</time></p>
  </div>
  <div class="tgrid">
    <article class="textcard">
      <details class="toc-top"><summary>İçindekiler</summary><!--TOC--></details>
      {{ content | safe }}
    </article>
    <aside class="side">
      <nav class="toc-side" aria-label="İçindekiler"><h2>İçindekiler</h2><!--TOC--></nav>
      {% if digerleri.length %}
      <div class="others g" style="{{ gr | gstil }}">
        <h2>Bu başlıktaki diğer konular</h2>
        <ul>{% for k in digerleri | head(6) %}<li><a href="{{ k.url }}">{{ k.data.baslik }}</a></li>{% endfor %}</ul>
      </div>
      {% endif %}
    </aside>
  </div>
  <p class="foot-note">{{ site.uyari }}</p>
</div>
