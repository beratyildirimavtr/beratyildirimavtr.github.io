---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
<channel>
  <title>{{ site.ad }}</title>
  <link>{{ site.url }}/</link>
  <atom:link href="{{ site.url }}/feed.xml" rel="self" type="application/rss+xml"/>
  <description>{{ site.aciklama }}</description>
  <language>tr</language>
{%- for k in collections.konularSirali | head(30) %}
  <item>
    <title>{{ k.data.baslik | escape }}</title>
    <link>{{ site.url }}{{ k.url }}</link>
    <guid isPermaLink="true">{{ site.url }}{{ k.url }}</guid>
    <pubDate>{{ k.date | rfc822 }}</pubDate>
    <description>{{ (k.data.aciklama or "") | kisalt(300) | escape }}</description>
  </item>
{%- endfor %}
</channel>
</rss>
